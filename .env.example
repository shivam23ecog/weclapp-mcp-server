# Your weclapp tenant's API base URL (no trailing slash)
WECLAPP_BASE_URL=https://ecog.weclapp.com/webapp/api/v1

# The API token you generated in weclapp under Settings -> API
WECLAPP_API_TOKEN=paste-your-token-here

# A secret YOU make up, used to stop random people on the internet
# from calling your MCP server. Claude will need to send this back
# to you as a Bearer token when you set up the connector.
MCP_SHARED_SECRET=choose-a-long-random-string

# Port the server listens on (most hosts set this automatically)
PORT=3000
